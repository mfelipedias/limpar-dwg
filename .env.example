# Copie para .env e ajuste.

# Porta publicada no servidor
PORT=8080

# Login do site (opcional). Se WEB_PASSWORD ficar vazio, o site fica aberto.
WEB_USER=mobi
WEB_PASSWORD=

# Tamanho maximo de cada DWG enviado (MB)
MAX_UPLOAD_MB=1024

# Por quanto tempo os arquivos ficam no servidor (horas)
RETENTION_HOURS=48

# Quantos arquivos limpar ao mesmo tempo (cada um pode usar varios GB de RAM)
CONCURRENCY=1

# Tempo maximo de uma limpeza (minutos)
JOB_TIMEOUT_MINUTES=30
